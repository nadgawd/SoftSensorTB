# Only needed to test the online setup locally; plain `./run.sh` works without
# this file. Copy to frontend/.env.local (ignored by git) and fill in.

# Where the backend is. Empty means same origin, which the Vite dev proxy handles.
VITE_API_BASE_URL=

# Supabase project URL and the publishable (anon) key. Both are public by design;
# never put the service_role / secret key here. Leave empty to turn sign-in off.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
