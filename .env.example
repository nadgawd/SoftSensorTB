# Cloud LLM keys (used when LLM_MODE=cloud or as fallback in local_first)
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Database — local SQLite or hosted Postgres (async drivers are applied automatically)
#   DATABASE_URL="sqlite:///./local_test.db"
#   DATABASE_URL="postgresql://user:pass@host/db"
DATABASE_URL=

# Comma-separated browser origins allowed to call the API. Defaults to "*" for
# local development; online it is the Pages origin, e.g. https://you.github.io
CORS_ALLOW_ORIGINS=*

# --- Users and storage (online deployment; see DEPLOY.md) ---
# false: every request is the single local user, no Supabase needed.
AUTH_REQUIRED=false
# local: files under data_storage/.  supabase: the private Storage bucket below.
STORAGE_BACKEND=local
# Needed when AUTH_REQUIRED=true or STORAGE_BACKEND=supabase.
SUPABASE_URL=
# Server-side only. Never put it in the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=sst-data
# Only for projects still on the legacy shared JWT secret; leave empty otherwise.
SUPABASE_JWT_SECRET=

# Limits. Rate and dataset caps default to off locally and on when AUTH_REQUIRED=true.
MAX_UPLOAD_MB=25
# CHAT_RATE_LIMIT_PER_HOUR=40
# MAX_DATASETS_PER_USER=3
# MAX_PROJECT_STATE_MB=5

# OpenRouter free models change; override the defaults in backend/agents/llm_client.py.
# OPENROUTER_EXECUTION_MODEL=qwen/qwen3.8-27b:free
# OPENROUTER_KNOWLEDGE_MODEL=google/gemma-4-31b-it:free

# --- IITD HPC / local vLLM (see hpc/README.md) ---
# LLM_MODE: cloud | local | local_first
LLM_MODE=cloud

# After SSH tunnel: bash hpc/tunnel.sh  →  localhost:8888
LOCAL_LLM_BASE_URL=http://localhost:8888/v1
# run.sh copies the cluster's hpc/.llm_api_key here; the vLLM server requires it.
LOCAL_LLM_API_KEY=EMPTY

# A model profile from hpc/env.sh: qwen3.5-27b (default) or qwen2.5-7b (fallback).
# The profile is also the name vLLM serves the model under, and run.sh reads
# LOCAL_LLM_EXECUTION_MODEL to decide which profile to start on the cluster.
# vLLM serves exactly one model per server, so all three point at the same alias;
# naming anything else here yields a 404 and a silent fallback to cloud.
#
# The router shares this model on purpose. Its rule layer settles most turns
# before any model is called (tests/test_router.py), so the handful that get
# through do not justify a second server or a fine-tuned classifier.
LOCAL_LLM_EXECUTION_MODEL=qwen3.5-27b
LOCAL_LLM_KNOWLEDGE_MODEL=qwen3.5-27b
LOCAL_LLM_ROUTER_MODEL=qwen3.5-27b

# 1 when the local model can reason before answering (qwen3.5-27b can,
# qwen2.5-7b cannot). Enables the chat's "Think" toggle.
LOCAL_LLM_THINKING=1
